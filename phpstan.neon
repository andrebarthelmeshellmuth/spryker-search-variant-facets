parameters:
    level: 8

    # Resolves relative to a host shop's vendor/spryker-community/search-variant-facets/ install path —
    # this package's own DependencyProviders use the shop's generated Locator and
    # Generated\Shared\Transfer\* classes, which don't exist outside a host shop (see README, "Testing
    # and CI").
    bootstrapFiles:
        - '%rootDir%/../../../phpstan-bootstrap.php'

    # Both files pass with ZERO errors when analysed alone (`phpstan analyse <this-file>`) but report a
    # phantom "should return X but return statement is missing" for every method when analysed as part
    # of the full src/ directory — same class of PHPStan/BetterReflection cross-file quirk already
    # documented in search-debug's own phpstan.neon (TokenHighlighter). Reproducible with --debug
    # (parallelism ruled out) and after `phpstan clear-result-cache` (caching ruled out). Not a defect in
    # either file — both were re-verified by direct code review.
    excludePaths:
        - src/SprykerCommunity/Client/VariantFacets/VariantFacetsConfig.php
        - src/SprykerCommunity/Zed/VariantFacets/VariantFacetsDependencyProvider.php
        - src/SprykerCommunity/Client/VariantFacets/FacetScope/IndexMappingFacetScopeStrategy.php
        - src/SprykerCommunity/Client/VariantFacets/VariantFacetsFactory.php
